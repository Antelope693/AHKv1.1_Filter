SetStoreCapsLockMode, Off
#D::return

; ===== 中键 = 模拟左键（支持拖拽） =====
$MButton::
    SendInput, {LButton Down}
    KeyWait, MButton
    SendInput, {LButton Up}
return

; ===== 左键按住 = 高速连发逗号 ,（间隔 12ms） =====
$LButton::
    SetTimer, FastComma, 12
    KeyWait, LButton
    SetTimer, FastComma, Off
return

FastComma:
    SendInput, {,}
return
