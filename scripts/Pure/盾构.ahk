#Persistent
#InstallKeybdHook
DetectHiddenWindows, On
OnMessage(32769, "__AHK_Filter_OnMsg")
__AHK_Filter_Ready := 1
Suspend, On

__AHK_Filter_OnMsg(wParam, lParam)
{
    if (wParam = 1)
        Suspend, Off
    else if (wParam = 0)
        Suspend, On
    else if (wParam = 3)
        return 1
    return 0
