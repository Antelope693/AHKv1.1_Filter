# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Packaging
build/
dist/
*.egg-info/
*.spec

# IDE
.idea/
.vscode/
*.swp

# Local runtime state (machine-specific)
ahk_filter_config.json
ahk_filter_config.tmp
.cache/

# User scripts under scripts/ — only Pure_* examples are tracked
scripts/**/*.ahk
!scripts/Pure/
!scripts/Pure/Pure_*.ahk

# Legacy root-level personal scripts only
/*.ahk

# OS junk
Thumbs.db
Desktop.ini
.DS_Store
